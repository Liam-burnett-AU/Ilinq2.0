# Base URL the browser uses for Schoolbox API calls.
# In dev and with server/proxy.mjs this is a same-origin path that is proxied
# to SCHOOLBOX_ORIGIN, which avoids CORS and lets the PHPSESSID cookie work.
VITE_API_BASE=/sb

# The Schoolbox instance that iLINQ runs on.
SCHOOLBOX_ORIGIN=https://ilinq.sheldoncollege.com

# Port for the production proxy server (server/proxy.mjs)
PORT=8080
